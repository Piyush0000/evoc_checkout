generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(uuid())
  phone            String            @unique
  email            String?           @unique
  firstName        String?
  lastName         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  addresses        Address[]
  checkoutSessions CheckoutSession[]
}

model Address {
  id               String            @id @default(uuid())
  userId           String
  type             AddressType       @default(HOME)
  firstName        String
  lastName         String
  flatHouse        String
  areaStreet       String
  landmark         String?
  receiversPhone   String
  city             String
  state            String
  pincode          String
  isDefault        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id])
  checkoutSessions CheckoutSession[]

  @@index([userId])
}

model CheckoutSession {
  id                   String        @id @default(uuid())
  userId               String?
  items                Json
  totalAmount          Float
  currency             String        @default("INR")
  status               SessionStatus @default(PENDING_AUTH)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  addressId            String?
  gatewayClientSecret  String?
  gatewayTransactionId String?
  paymentGateway       String?
  storeId              String
  address              Address?      @relation(fields: [addressId], references: [id])
  user                 User?         @relation(fields: [userId], references: [id])

  @@index([storeId])
  @@index([userId])
}

model OtpVerification {
  id                String   @id @default(uuid())
  phone             String
  code              String?
  sessionId         String
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  providerSessionId String?

  @@index([phone])
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum SessionStatus {
  PENDING_AUTH
  AUTHENTICATED
  ADDRESS_CONFIRMED
  PAYMENT_PENDING
  COMPLETED
  FAILED
}
